# Copy to .env to override settings. Every setting has a working default,
# so the API starts without a .env file.

# Title shown on the API docs page at /docs
COPILOT_APP_NAME=African Economic Intelligence Copilot

# Log level: debug, info, warning, error or critical
COPILOT_LOG_LEVEL=info

# Folder of the demo Parquet snapshot read in demo mode
COPILOT_DATA_DIR=data/demo

# Postgres connection string for saved investigations. Unset by default; the
# migration commands and the database integration tests need it. Local
# database started with the docker run line in _docs/AGENTS.md:
# DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# Date of the demo snapshot shown in the banner. When unset it is read from
# data/demo/README.md; if neither is found the page says the data mode is unknown.
# COPILOT_DEMO_SNAPSHOT_DATE=

# Gemini API key. Without it the app starts, and investigation runs fail with
# "Gemini is not configured". Never commit a real key.
# COPILOT_GEMINI_API_KEY=

# Gemini model: the current stable Gemini Flash model
COPILOT_GEMINI_MODEL=gemini-3.6-flash

# Seconds to wait for one Gemini call, retries of 429 and 5xx errors, and the
# output token limit of one call
COPILOT_GEMINI_TIMEOUT_SECONDS=30
COPILOT_GEMINI_MAX_RETRIES=3
COPILOT_GEMINI_MAX_OUTPUT_TOKENS=4096

# Tool rounds per run, data points one tool call may load, the time limit of a
# whole run, how long a pending run waits for its stream, and the longest gap
# between events while a run streams (seconds)
COPILOT_TOOL_STEP_LIMIT=8
COPILOT_MAX_TOOL_RESULT_POINTS=500
COPILOT_INVESTIGATION_TIME_LIMIT_SECONDS=90
COPILOT_PENDING_RUN_TIMEOUT_SECONDS=300
COPILOT_STREAM_PING_SECONDS=15
