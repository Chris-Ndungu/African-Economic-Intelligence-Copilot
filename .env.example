# Copy to .env to override settings. Every setting has a working default,
# so the API starts without a .env file.

# Title shown on the API docs page at /docs
COPILOT_APP_NAME=African Economic Intelligence Copilot

# Log level: debug, info, warning, error or critical
COPILOT_LOG_LEVEL=info

# Postgres connection string for saved investigations. Unset by default; the
# migration commands and the database integration tests need it. Local
# database started with the docker run line in _docs/AGENTS.md:
# DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot
